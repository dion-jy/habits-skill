    secret = args.secret
    if not secret:
        print("  Usage: habits link <agent_secret>")
        print("  Get the code from app: Settings → Link Agent")
        return
    # Save and verify
    _save_user(None, None, secret)
    try:
        habits = _get(f"habits?select=id&limit=1")
        print(f"  Linked! Found {len(habits)} habit(s).")
    except Exception as e:
        print(f"  Warning: could not verify ({e}). Check the code and try again.")


