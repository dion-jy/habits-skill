REST = f"{SUPABASE_URL}/rest/v1"


# --- HTTP ---

def _agent_secret():
    user = _load_user()
    if user and user.get("agent_secret"):
        return user["agent_secret"]
    return None


def _headers(extra=None):
    h = {
        "apikey": SUPABASE_ANON_KEY,
        "Authorization": f"Bearer {SUPABASE_ANON_KEY}",
        "Content-Type": "application/json",
    }
    secret = _agent_secret()
    if secret:
        h["x-agent-secret"] = secret
    if extra:
        h.update(extra)
    return h


def _get(path):
    req = Request(f"{REST}/{path}", headers=_headers())
    with urlopen(req) as resp:
        return json.loads(resp.read())


def _post(path, data, extra_headers=None):
    body = json.dumps(data).encode()
    req = Request(f"{REST}/{path}", data=body, headers=_headers(extra_headers))
    with urlopen(req) as resp:
        return json.loads(resp.read())


# --- User ---

def _save_user(user_id, device_id, agent_secret=None):
    data = {}
    if os.path.exists(_user_path):
        with open(_user_path) as f:
            data = json.load(f)
    if user_id:
        data["user_id"] = user_id
    if device_id:
        data["device_id"] = device_id
    if agent_secret:
        data["agent_secret"] = agent_secret
    fd = os.open(_user_path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        json.dump(data, f)


def _load_user():
    if not os.path.exists(_user_path):
        return None
    with open(_user_path) as f:
        return json.load(f)


def _require_user():
    user = _load_user()
    if not user or not user.get("agent_secret"):
        print("Not linked. Run 'habits link <code>' first.")
        print("Get the code from app: Settings → Link Agent")
        sys.exit(1)
    return user


def _user_id():
    return _require_user()["user_id"]


def _user_device_id():
    return _require_user()["device_id"]


def _user_filter():
    """RLS handles filtering via x-agent-secret header. Return minimal filter."""
    _require_user()  # just verify linked
    return "id=gt.0"  # no-op filter, RLS does the real scoping


def _resolve_habit(name):
    habits = _get(f"habits?{_user_filter()}&select=id,name,device_id")
    for h in habits:
        if h["name"].lower() == name.lower():
            return h
    for h in habits:
        if name.lower() in h["name"].lower():
            return h
    return None


# --- Commands ---

def cmd_link(args):
